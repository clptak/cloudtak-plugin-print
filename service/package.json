{
    "name": "cloudtak-print-service",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Headless render service for cloudtak-plugin-print",
    "engines": {
        "node": ">= 24"
    },
    "scripts": {
        "check": "tsc --noEmit --project tsconfig.json",
        "lint": "eslint index.ts routes/ lib/ test/",
        "test": "tsx --test test/*.test.ts",
        "build": "tsc --project tsconfig.json",
        "dev": "tsx watch index.ts",
        "prod": "node dist/index.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.726.1",
        "@openaddresses/batch-error": "^2.9.0",
        "@openaddresses/batch-schema": "^10.12.1",
        "@sinclair/typebox": "^0.34.11",
        "cors": "^2.8.5",
        "express": "^5.0.0",
        "jsonwebtoken": "^9.0.0",
        "maplibre-gl": "^6.0.0",
        "playwright": "^1.49.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/node": "^26.0.0",
        "eslint": "^10.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    }
}
