# Shared with cloudtak-api / cloudtak-tiles / cloudtak-events. Required.
SigningSecret=

# Internal service URLs on the tak-network docker network.
API_INTERNAL_URL=http://cloudtak-api:5000
TILES_INTERNAL_URL=http://cloudtak-tiles:5002

# The PUBLIC hosts as they appear in style documents are derived from CloudTAK's
# own API_URL and PMTILES_URL, which are already correct in the stack's .env.
# Requests to them are rewritten to the internal URLs above so tile fetches never
# leave the box. Only set these to override:
# API_PUBLIC_HOST=
# TILES_PUBLIC_HOST=

# Third-party basemap hosts the renderer may contact.
#
# Normally EMPTY, and that is not a limitation. CloudTAK proxies every
# non-hosted basemap through its own API -- see api/stateless/lib/tilejson.ts:
# the browser fetches /api/basemap/:id/tiles/{z}/{x}/{y}, and cloudtak-api
# fetches upstream. So Caltopo, Google, ArcGIS, USGS and the rest are already
# reachable without being listed here, and listing them would widen the SSRF
# surface for no gain.
PRINT_ALLOW_HOSTS=

# MinIO bucket for finished sheets (phase 2).
ASSET_BUCKET=

PRINT_PORT=5010

# Concurrent render jobs. Keep at 1 until you have measured on the target box:
# one render already uses every core PRINT_CPUS allows.
PRINT_CONCURRENCY=1

# Container CPU and memory limits, consumed by docker-compose rather than the
# service itself. SwiftShader parallelises, so CPU is the main lever on render
# time. Default 4 suits an 8-core host; raise it on a larger one.
PRINT_CPUS=4.0
PRINT_MEMORY=4G

# Abandon a render after this long. Raise it for very large sheets rather than
# leaving a stuck job holding the queue.
PRINT_RENDER_TIMEOUT_SECONDS=180

# Output resolution ceiling. Raise once TAK Server moves off this host.
PRINT_MAX_DPI=200

# CSS pixels per inch used for layout. Controls printed LABEL DENSITY,
# independently of output resolution. Lower = sparser, more map-like labelling.
PRINT_LAYOUT_DPI=96

# Seconds a finished job is retained in memory.
PRINT_JOB_TTL_SECONDS=3600
